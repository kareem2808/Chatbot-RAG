# ──────────────────────────────────────────────
#  Konfigurasi Sistem RAG
#  Salin file ini menjadi .env dan isi nilainya
# ──────────────────────────────────────────────

# [WAJIB] API Key Google Gemini 1.5 Flash (Bisa kosong jika LLM_PROVIDER=groq)
GEMINI_API_KEY=your_gemini_api_key_here

# [OPSIONAL] Provider LLM utama: 'gemini' atau 'groq' (default: gemini)
LLM_PROVIDER=gemini

# [WAJIB] API Key Groq (Bisa kosong jika LLM_PROVIDER=gemini)
GROQ_API_KEY=your_groq_api_key_here

# [OPSIONAL] Path ke ChromaDB (default: ./data/chroma_db)
CHROMA_DB_PATH=./data/chroma_db

# [OPSIONAL] Jumlah retry maksimum untuk panggilan API (0-10, default: 3)
MAX_RETRIES=3

# [OPSIONAL] Batas request per menit (1-600, default: 60)
RATE_LIMIT_PER_MINUTE=60

# [OPSIONAL] Level logging: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# [OPSIONAL] Direktori penyimpanan log (default: ./logs)
LOG_DIR=./logs

# [OPSIONAL] Nama aplikasi (default: rag-system)
APP_NAME=Chatbot-RAG

# [OPSIONAL] Environment: development, staging, production (default: development)
ENVIRONMENT=development

# [OPSIONAL] API keys untuk autentikasi (comma-separated, kosongkan jika tidak pakai auth)
# API_KEYS=key1-abc123,key2-def456

# [OPSIONAL] CORS origins (comma-separated, default: * untuk development)
# CORS_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
